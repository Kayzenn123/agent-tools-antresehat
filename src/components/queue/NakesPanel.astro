---
/**
 * NakesPanel — dashboard nakes di sheet LOKET.
 * Tombol panggil-satu-klik + kontrol antrean + rekap + ekspor.
 * Semua aksi nyata dihubungkan JS (agent B); copy persona Bu RT.
 */
import { LOKET } from '~/data/loket';
---

<div class="nakes-panel border-2 border-dashed p-4" style="border-color: var(--text)">
  <h3 class="font-display text-xl font-bold uppercase tracking-widest">Dashboard nakes</h3>
  <p class="mt-1 text-base" style="color: var(--muted)">
    Satu ketuk = satu panggilan, Bu… nggak perlu toa lagi. (contoh)
  </p>

  <div class="mt-4">
    <label for="loket-nakes" class="font-display block text-sm font-bold uppercase tracking-widest">
      Loket yang dijaga
    </label>
    <select id="loket-nakes" class="mt-1 w-full border-2 p-3" style="border-color: var(--text); background: var(--surface)">
      {LOKET.map((l) => (
        <option value={l.id}>{l.id} — {l.nama} (kode {l.kode})</option>
      ))}
    </select>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-2">
    <button id="btn-panggil" type="button" class="font-display col-span-2 p-4 text-xl font-bold uppercase tracking-widest" style="background: var(--accent-2); color: var(--bg)">
      Panggil berikutnya
    </button>
    <button id="btn-ulang" type="button" class="border-2 p-3 font-bold" style="border-color: var(--text)">
      Panggil ulang
    </button>
    <button id="btn-selesai" type="button" class="border-2 p-3 font-bold" style="border-color: var(--text)">
      Selesai
    </button>
    <button id="btn-lewati" type="button" class="border-2 p-3 font-bold" style="border-color: var(--text)">
      Lewati
    </button>
    <button id="btn-reset" type="button" class="border-2 border-dashed p-3 font-bold" style="border-color: var(--pop); color: var(--pop)">
      Reset antrean
    </button>
  </div>
  <p id="nakes-pesan" class="mt-2 min-h-[1.5em] text-base" role="status" aria-live="polite"></p>

  <div id="rekap" class="mt-4 border-t border-dashed pt-3" style="border-color: var(--muted)">
    <h4 class="font-display text-sm font-bold uppercase tracking-widest" style="color: var(--muted)">Rekap hari ini (contoh)</h4>
    <!-- diisi JS: jumlah dilayani / menunggu / terlewat -->
  </div>

  <div class="mt-3 flex flex-wrap gap-2">
    <button id="btn-export-csv" type="button" class="border-2 px-3 py-2 text-sm font-bold" style="border-color: var(--text)">Unduh CSV</button>
    <button id="btn-export-json" type="button" class="border-2 px-3 py-2 text-sm font-bold" style="border-color: var(--text)">Unduh JSON</button>
    <button id="btn-salin-wa" type="button" class="border-2 px-3 py-2 text-sm font-bold" style="border-color: var(--text)">Salin untuk WA</button>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 border-t border-dashed pt-3" style="border-color: var(--muted)">
    <button id="toggle-gerak" type="button" aria-pressed="true" class="border-2 px-3 py-2 text-sm font-bold" style="border-color: var(--text)">
      Gerak: nyala
    </button>
    <button id="toggle-suara" type="button" aria-pressed="true" class="border-2 px-3 py-2 text-sm font-bold" style="border-color: var(--text)">
      Suara: nyala
    </button>
  </div>
</div>

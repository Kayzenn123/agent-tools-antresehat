---
/**
 * DividerSobek — garis sobek dashed antar blok (gaya karcis disobek).
 * Pakai class .divider-sobek dari queue.css (lubang di kedua ujung).
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: cls = '', label = '' } = Astro.props;
---
<div class:list={['pembungkus-sobek', cls]} aria-hidden={label ? undefined : 'true'}>
  <hr class="divider-sobek" />
  {
    label && (
      <p
        class="font-display text-center text-xs uppercase"
        style="letter-spacing: 0.2em; color: var(--muted); margin-top: -2.1rem; margin-bottom: 1.2rem;"
      >
        <span style="background: var(--bg); padding: 0 0.75rem;">{label}</span>
      </p>
    )
  }
</div>
